<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_korijen"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_pozadina"
    android:orientation="vertical"
    android:paddingHorizontal="14dp"
    android:paddingVertical="12dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:letterSpacing="0.08"
            android:text="@string/widget_stanje_racuna"
            android:textColor="#9AA7B8"
            android:textSize="11dp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/widget_ciklus"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="#00D8F6"
            android:textSize="11dp" />
    </LinearLayout>

    <TextView
        android:id="@+id/widget_stanje"
        android:layout_width="match_parent"
        android:layout_height="38dp"
        android:layout_marginTop="0dp"
        android:autoSizeMaxTextSize="30dp"
        android:autoSizeMinTextSize="16dp"
        android:autoSizeTextType="uniform"
        android:fontFeatureSettings="tnum"
        android:gravity="center_vertical"
        android:maxLines="1"
        android:shadowColor="#7300F5A0"
        android:shadowRadius="18"
        android:text="0,00 €"
        android:textColor="#00F5A0"
        android:textSize="30dp"
        android:textStyle="bold" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:orientation="horizontal">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginEnd="4dp"
            android:layout_weight="1"
            android:background="@drawable/widget_plocica"
            android:orientation="vertical"
            android:paddingHorizontal="10dp"
            android:paddingVertical="4dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/widget_ulaz"
                android:textColor="#9AA7B8"
                android:textSize="11dp" />

            <TextView
                android:id="@+id/widget_ulaz"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:fontFeatureSettings="tnum"
                android:maxLines="1"
                android:textColor="#00F5A0"
                android:textSize="13dp"
                android:textStyle="bold" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="4dp"
            android:layout_weight="1"
            android:background="@drawable/widget_plocica"
            android:orientation="vertical"
            android:paddingHorizontal="10dp"
            android:paddingVertical="4dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/widget_izlaz"
                android:textColor="#9AA7B8"
                android:textSize="11dp" />

            <TextView
                android:id="@+id/widget_izlaz"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:fontFeatureSettings="tnum"
                android:maxLines="1"
                android:textColor="#FF5376"
                android:textSize="13dp"
                android:textStyle="bold" />
        </LinearLayout>
    </LinearLayout>

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:minHeight="8dp" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/widget_gumb_trosak"
            android:layout_width="0dp"
            android:layout_height="40dp"
            android:layout_marginEnd="4dp"
            android:layout_weight="1"
            android:background="@drawable/widget_gumb_trosak"
            android:gravity="center"
            android:text="@string/widget_dodaj_trosak"
            android:textColor="#FF5376"
            android:textSize="14dp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/widget_gumb_prihod"
            android:layout_width="0dp"
            android:layout_height="40dp"
            android:layout_marginStart="4dp"
            android:layout_weight="1"
            android:background="@drawable/widget_gumb_prihod"
            android:gravity="center"
            android:text="@string/widget_dodaj_prihod"
            android:textColor="#04140E"
            android:textSize="14dp"
            android:textStyle="bold" />
    </LinearLayout>
</LinearLayout>
